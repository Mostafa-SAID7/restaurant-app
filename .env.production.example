# Frontend Configuration
FRONTEND_PORT=4200
API_URL=https://api.restaurant-app.com
ENVIRONMENT=production

# Backend Configuration
BACKEND_PORT=3000
DATABASE_URL=postgresql://prod_user:prod_password@prod-db-host:5432/restaurant_db
NODE_ENV=production

# Authentication
JWT_SECRET=your-production-super-secret-jwt-key
JWT_EXPIRATION=7d

# Email Service (SendGrid)
SENDGRID_API_KEY=your-production-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@restaurant-app.com

# Payment Processing (Stripe)
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# Logging
LOG_LEVEL=warn
DEBUG=false

# CORS
CORS_ORIGIN=https://restaurant-app.com

# Session
SESSION_SECRET=your-production-session-secret-key
SESSION_TIMEOUT=3600000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=/var/uploads

# External APIs
GOOGLE_MAPS_API_KEY=your-production-google-maps-api-key
GOOGLE_ANALYTICS_ID=your-production-google-analytics-id

# SSL/TLS
SSL_CERT_PATH=/etc/ssl/certs/restaurant-app.crt
SSL_KEY_PATH=/etc/ssl/private/restaurant-app.key

# Database Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # 2 AM daily

# Monitoring
SENTRY_DSN=your-sentry-dsn
DATADOG_API_KEY=your-datadog-api-key
